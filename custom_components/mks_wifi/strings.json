{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "step": {
      "reconfigure": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]"
        },
        "data_description": {
          "host": "[%key:component::mks_wifi::config::step::user::data_description::host%]",
          "port": "[%key:component::mks_wifi::config::step::user::data_description::port%]"
        }
      },
      "user": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]"
        },
        "data_description": {
          "host": "The hostname or IP address of the MKS WIFI module of your printer.",
          "port": "The TCP port the MKS WIFI module listens on, 8080 unless changed."
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "bed_target_temperature": {
        "name": "Bed target temperature"
      },
      "bed_temperature": {
        "name": "Bed temperature"
      },
      "elapsed": {
        "name": "Print time"
      },
      "extra_nozzle_target_temperature": {
        "name": "Nozzle {nozzle} target temperature"
      },
      "extra_nozzle_temperature": {
        "name": "Nozzle {nozzle} temperature"
      },
      "file_name": {
        "name": "Current file"
      },
      "nozzle_target_temperature": {
        "name": "Nozzle target temperature"
      },
      "nozzle_temperature": {
        "name": "Nozzle temperature"
      },
      "progress": {
        "name": "Progress"
      },
      "state": {
        "name": "State",
        "state": {
          "idle": "[%key:common::state::idle%]",
          "paused": "[%key:common::state::paused%]",
          "printing": "Printing"
        }
      }
    }
  },
  "exceptions": {
    "communication_error": {
      "message": "An error occurred while communicating with the printer."
    }
  }
}
